# FastAPI only. Use separate PostgreSQL databases for development and tests.
DATABASE_URL=postgresql+psycopg://<app_role>:<password>@localhost:5432/admission_coach
TEST_DATABASE_URL=postgresql+psycopg://<app_role>:<password>@localhost:5432/admission_coach_test

# Browser origin allowed by FastAPI CORS.
WEB_ORIGIN=http://localhost:3000

# FastAPI only. Never expose the service-role key through NEXT_PUBLIC_* variables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=application-documents
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>

# Browser-safe web configuration. Use the Supabase publishable key, not service_role.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
